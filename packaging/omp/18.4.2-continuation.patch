@@ -4317,6 +4327,20 @@ export class AgentSession implements SettingsScope {
 
 				const active = this.#activeAgentContinue;
 				if (active) {
+					if (active.agentEndSequence !== request.agentEndSequence) {
+						// The active loop already yielded; it cannot consume recovery work
+						// requested by that yield. Wait for its ownership to unwind, then
+						// re-admit the request with the generation/cancellation guards.
+						const outcome = await active.promise;
+						if (outcome.status !== "completed") {
+							this.#handleAgentContinueOutcome(outcome, request);
+						} else if (signal.aborted || this.#isDisposed) {
+							this.#skipAgentContinue("session-unavailable", request);
+						} else {
+							this.#scheduleAgentContinue(options);
+						}
+						return;
+					}
 					active.coalescedSources.add(options.source);
 					logger.debug("agent.continue coalesced after scheduling", {
 						source: options.source,
@@ -4333,6 +4357,7 @@ export class AgentSession implements SettingsScope {
 				const promise = this.#runAgentContinue(signal, request, coalescedSources);
