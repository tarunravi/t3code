From cbfd27f82d90f78d6d579f53b86b7524a6350240 Mon Sep 17 00:00:00 2001
From: Tarun <tarun@Taruns-MacBook-Pro.local>
Date: Sun, 25 Oct 2026 00:10:28 -0400
Subject: [PATCH] fix(session): retain recovery requested after a continuation
 yields

---
 packages/coding-agent/CHANGELOG.md            |  4 ++
 .../coding-agent/src/session/agent-session.ts | 29 ++++++++++++-
 .../coding-agent/src/session/turn-recovery.ts | 14 ++++--
 ...gent-session-auto-compaction-queue.test.ts | 43 +++++++++++++++++++
 ...gent-session-unexpected-stop-guard.test.ts | 10 +++++
 5 files changed, 94 insertions(+), 6 deletions(-)

diff --git a/packages/coding-agent/CHANGELOG.md b/packages/coding-agent/CHANGELOG.md
index 65b5e4f..6570c42 100644
--- a/packages/coding-agent/CHANGELOG.md
+++ b/packages/coding-agent/CHANGELOG.md
@@ -2,6 +2,10 @@
 
 ## [Unreleased]
 
+### Fixed
+
+- Continued recovery after a prior continuation yields, and stopped with a visible error when incomplete-answer retries are exhausted.
+
 ## [18.4.2] - 2026-09-28
 
 ### Added
